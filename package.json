{
  "name": "unmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strip watermarks and provenance marks in your browser. Nothing leaves your device.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "assets": "node scripts/fetch-assets.mjs && node scripts/make-icons.mjs",
    "build:skill": "vite build --config vite.skill.config.ts",
    "verify:skill": "node scripts/verify-skill-bundle.mjs",
    "check:network": "node scripts/check-network.mjs dist",
    "shoot": "node scripts/shoot.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:perf && pnpm check:imports && pnpm build:skill && pnpm verify:skill && pnpm build && pnpm check:network",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "check:imports": "node scripts/check-imports.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@mlc-ai/web-tokenizers": "0.1.6",
    "franc-min": "^6.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^30.1.3",
    "onnxruntime-web": "^1.31.1",
    "oxlint": "^1.75.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
